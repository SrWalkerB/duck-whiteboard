generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Room {
  id              String           @id @default(uuid())
  tokenHash       String           @unique
  currentSequence BigInt           @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  snapshots       BoardSnapshot[]
  operations      BoardOperation[]
  outboxEvents    OutboxEvent[]
}

model BoardSnapshot {
  id        String   @id @default(uuid())
  roomId    String
  sequence  BigInt
  scene     Json
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, sequence])
  @@index([roomId, sequence(sort: Desc)])
}

model BoardOperation {
  id          String   @id @default(uuid())
  roomId      String
  sequence    BigInt
  operationId String
  actorId     String
  type        String
  payload     Json
  createdAt   DateTime @default(now())
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, sequence])
  @@unique([roomId, operationId])
  @@index([roomId, sequence])
}

model OutboxEvent {
  id          String    @id @default(uuid())
  roomId      String
  type        String
  payload     Json
  availableAt DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([publishedAt, availableAt])
}
