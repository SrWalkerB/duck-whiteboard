# Copie para .env e ajuste conforme o modo:  cp .env.example .env

# ============================================================
# Modo http (padrão) — ./deploy.sh   ou   ./deploy.sh http
# Serve HTTP direto na porta abaixo. Bom para local ou atrás de
# um proxy externo (Cloudflare, nginx, etc.).
# ============================================================
HTTP_PORT=8080
SITE_ADDRESS=:80

# ============================================================
# Modo tls — ./deploy.sh tls
# O próprio Caddy emite o certificado (Let's Encrypt).
# Requer domínio apontando pro servidor e portas 80/443 abertas.
# Dica: defina HTTP_PORT=80 acima neste modo.
# ============================================================
APP_DOMAIN=
HTTPS_PORT=443

# ============================================================
# Modo traefik — ./deploy.sh traefik
# Sem publicar porta; entra na rede do Traefik e usa labels.
# Os padrões abaixo já casam com o proxy central `duck-enterprise-server`.
# Só mude se o seu Traefik usar outros nomes.
# ============================================================
PROXY_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
CERT_RESOLVER=le

# ============================================================
# Opcionais (todos os modos)
# ============================================================
# IMAGE=duck-whiteboard:latest
# CONTAINER_NAME=duckboard

# ============================================================
# Salas colaborativas — ativadas por padrão no deploy.
# Use senhas URL-safe (letras, números, - e _) porque elas entram nas URLs de
# conexão dos containers. Não publique este arquivo já preenchido.
# ============================================================
COLLABORATION_ENABLED=true
POSTGRES_DB=duckboard
POSTGRES_USER=duckboard
POSTGRES_PASSWORD=troque-por-uma-senha-longa-url-safe
RABBITMQ_USER=duckboard
RABBITMQ_PASSWORD=troque-por-outra-senha-longa-url-safe

# A origem pública que acessa o quadro. Em produção, use o domínio real,
# por exemplo: CORS_ORIGIN=https://board.seudominio.com
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Estas portas ficam presas ao localhost do servidor para diagnóstico.
API_PORT=3001
RABBITMQ_MANAGEMENT_PORT=15672
